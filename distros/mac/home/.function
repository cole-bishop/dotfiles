# git function for pulling all known remote branches and updating them all.
# Found at https://stackoverflow.com/questions/10312521/how-to-fetch-all-git-branches#10312587
function guab ()
{
  git branch -r | grep -v '\->' | while read remote; do git branch --track "${remote#origin/}" "$remote"; done
  git fetch --all
  git pull --all
}
# stage-commit-version-files
function scvf() {
	git diff --name-only "$1~1" "$1"|xargs git checkout "$1"
}
# working-directory-commit-version-files
function wdcvf() {
	git diff --name-only "$1~1" "$1"|xargs git checkout "$1"
	git diff --name-only "$1~1" "$1"|xargs git reset
}
function apply-commit-version-diff() {
	git apply <(git diff "$1~1" "$1")
}
# `tre` is a shorthand for `tree` with hidden files and color enabled, ignoring
# the `.git` directory, listing directories first. The output gets piped into
# `less` with options to preserve color and line numbers, unless the output is
# small enough for one screen.
function tre() {
	tree -aC -I '.git|node_modules|bower_components' --dirsfirst "$@" | less -FRNX;
}
# `o` with no arguments opens the current directory, otherwise opens the given
# location
function o() {
	if [ $# -eq 0 ]; then
		open .;
	else
		open "$@";
	fi;
}
# fix history file corruption
function fixHistfileCorruption() {
  mv "$HOME/.histfile" "$HOME/.histfile_bad"
  strings -eS "$HOME/.histfile_bad" > "$HOME/.histfile"
  fc -R "$HOME/.histfile"
  rm "$HOME/.histfile_bad"
}
# Puts a random UUID on the clipboard.
uuid() {
  UUID=$(uuidgen | tr -d '\n'|tr '[:upper:]' '[:lower:]')
  echo "$UUID" | tr -d '\n'|pbcopy
  echo "$UUID"
}

# Run `dig` and display the most useful info.
# Or use `drill` instead.
function digga() {
	dig +nocmd "$1" any +multiline +noall +answer;
}
# Determine size of a file or total size of a directory
function fs() {
	if du -b /dev/null > /dev/null 2>&1; then
		local arg=-sbh;
	else
		local arg=-sh;
	fi
	if [[ -n "$@" ]]; then
		du $arg -- "$@";
	else
		du $arg .[^.]* ./*;
	fi;
}
# Create a new directory and enter it
function mkd() {
	mkdir -p "$@" && cd "$_";
}

# To use java jar as cli tool.
# Place executable jars into $HOME/.tools/cli/java/jars,
# like bnd, and use like 'jjar bnd version'.
function jjar() {
  java -jar "$HOME/.tools/cli/java/jars/$1" "${@:2}"  
}
# Show wifi password for given SSID name.
function passwordForSsid() {
  nmcli --show-secrets connection show "$1"|grep wireless-security.psk:
}
# Show manually installed packages for xbuntu/debian.
function listManuallyInstalledPackagesApt() {
  comm -23 <(apt-mark showmanual | sort -u) <(gzip -dc /var/log/installer/initial-status.gz | sed -n 's/^Package: //p' | sort -u)
}
# Show manually installed packages for brew.
function listManuallyInstalledPackagesBrew() {
  brew list|sed 's/  /\\n/g'
}
# Show manually installed snap packages.
function listManuallyInstalledPackagesSnap() {
  snap list|grep -oIP '^[\w-]+'|tail -n +2
}

function ppgrep() { pgrep "$@" | xargs --no-run-if-empty ps fp; }

# k8s - allows you to tail logs of services even between restarts
klogs() {
  local service=$1
  kubectl logs services/$service -f ; echo "Disconected, awaiting service to come back online" && sleep 1 && log $service
}

# Copies the commit message of the commit of the 1st (or xth) commit ahead of HEAD to the clipboard.
copyCommitAheadMessage() {
  num_commits_ahead=${1:-1}
  eval "git rev-list --format=%B --max-count=1 HEAD@{$num_commits_ahead}|tail -n +2|pbcopy"
  echo "copied commit message to clipboard:\n$(pbpaste)"
}

function whoseUsingPort() {
  lsof -i -P | grep LISTEN | grep :$1 
}

function kshark() {
  kubectl exec $1 -- yum install -y tcpdump && kubectl exec $1 -- tcpdump -i eth0 -w - | wireshark -k -i - 
}

function grep-get-pod-name() {
  kubectl get pods --no-headers -o custom-columns=":metadata.name"|grep $1|head -n 1
}

function wait-until-pod-name-up() {
	echo "Waiting until pod $1 is up..."
	until [[ $(kubectl get pod $(grep-get-pod-name $1) -n default -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}') == "True" ]]; do
		sleep 1
	done
	echo "Pod $1 is up!"
}

function fzf-get-pod-name() {
  kubectl get pods --no-headers -o custom-columns=":metadata.name"|fzf
}

function clean-k-logs() {
  sed -e 's#\\n#\n#g' -e 's#\\t#\t#g'
}

function k-nuke-all() {
	kubectl delete deployments --all && kubectl delete services --all && kubectl delete configmap --all && kubectl delete jobs.batch --all;
}

function k-logs-by-name() {
  kubectl logs $(grep-get-pod-name $1)|clean-k-logs
}

function watch-k-logs-by-name() {
  watch --color -p -n 1 --exec zsh -c "source ~/.function && k-logs-by-name $1"
}

# Pretty printing
# $1 file to operate on
# $2 file to save as
function pretty-xml-inplace() {
	xmllint --format --output "$2" "$1"
}

function pretty-all-xml-inplace() {
	find . -type f -name "*.xml" -print0 | xargs -0 -I{} sh -c 'xmllint --format "{}" > "{}.tmp" && mv "{}.tmp" "{}"'
}




