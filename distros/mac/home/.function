# git function for pulling all known remote branches and updating them all.
# Found at https://stackoverflow.com/questions/10312521/how-to-fetch-all-git-branches#10312587
function guab ()
{
  git branch -r | grep -v '\->' | while read remote; do git branch --track "${remote#origin/}" "$remote"; done
  git fetch --all
  git pull --all
}

# Worktree functions
# Like gbal alias (see .alias),

# "git worktree (for existing branches)"
# Fzf most recently used branches,
# select one, and cd into a worktree for it, creating the worktree if it doesn't exist.
function gw() {
  local branch
  branch=$(git for-each-ref --sort=-committerdate --format="%(HEAD) %(color:yellow)%(refname:short)%(color:reset)" | fzf | sed "s#^[[:space:]]*origin/##g" | tr -d '[:space:]')
  [[ -z "$branch" ]] && return 1

  # Check if a worktree for this branch already exists (works even from within a worktree)
  local existing_path
  existing_path=$(git worktree list --porcelain | awk -v b="$branch" '/^worktree /{p=$0; sub(/^worktree /,"",p)} /^branch refs\/heads\//{ref=$0; sub(/^branch refs\/heads\//,"",ref); if(ref==b) print p}')
  if [[ -n "$existing_path" ]]; then
    echo "Worktree for branch $branch already exists at $existing_path. Switching to it."
    cd "$existing_path"
    return
  fi

  # Use the main worktree (first entry) as the canonical repo root
  local repo_root
  repo_root=$(git worktree list --porcelain | awk '/^worktree /{print $2; exit}')
  local repo_name
  repo_name=$(basename "$repo_root")

  local worktree_path
  worktree_path="$(dirname "$repo_root")/worktrees/$repo_name/$branch"

  echo "trying to create worktree at $worktree_path for branch $branch"
  if git show-ref --verify --quiet "refs/heads/$branch"; then
    git worktree add "$worktree_path" "$branch" && cd "$worktree_path"
  else
    # The 'origin/' prefix is required so git uses the existing remote branch
    # as the starting point rather than creating a new empty branch from HEAD.
    git worktree add --track -b "$branch" "$worktree_path" "origin/$branch" && cd "$worktree_path"

    # Make it not a headless state
    git checkout "$branch"
  fi
} 

# "git worktree create"
# Give a new branch name, create a worktree for it, 
# and cd into the worktree, or cd into the worktree if it already exists.
function gwc() {
  local branch="$1"
  [[ -z "$branch" ]] && echo "Usage: gwc <branch-name>" && return 1

  # Use the main worktree (first entry) as the canonical repo root
  local repo_root
  repo_root=$(git worktree list --porcelain | awk '/^worktree /{print $2; exit}')
  local repo_name
  repo_name=$(basename "$repo_root")

  local worktree_path
  worktree_path="$(dirname "$repo_root")/worktrees/$repo_name/$branch"

  if [[ -d "$worktree_path" ]] || git worktree list --porcelain | grep -qF "worktree $worktree_path"; then
    echo "Worktree for branch $branch already exists at $worktree_path. Switching to it."
    cd "$worktree_path"
  else
    echo "trying to create worktree at $worktree_path for branch $branch"
      git worktree add --track -b "$branch" "$worktree_path"
      cd "$worktree_path"
  fi
}

# "git worktree delete"
# Remove one or more git worktrees, sorted by most recently used, via fzf multi-select.
function gwd() {
  local main_path
  main_path=$(git worktree list --porcelain | awk 'NR==1{print $2}')

  local sorted_paths
  sorted_paths=$(git worktree list --porcelain \
    | awk '/^worktree /{print $2}' \
    | grep -vxF "$main_path" \
    | while IFS= read -r wt_path; do
        echo "$(stat -f '%m' "$wt_path" 2>/dev/null || echo 0) $wt_path"
      done \
    | sort -rn \
    | awk '{print $2}')

  [[ -z "$sorted_paths" ]] && echo "No removable worktrees found." && return 1

  local display_lines
  display_lines=$(while IFS= read -r wt_path; do
    git worktree list | grep "^$wt_path "
  done <<< "$sorted_paths")

  local selected
  selected=$(echo "$display_lines" \
    | fzf --multi --header="Select worktrees to remove (TAB for multi-select)" \
    | awk '{print $1}')

  [[ -z "$selected" ]] && return 0

  while IFS= read -r wt_path; do
    echo "Removing worktree: $wt_path"
    git worktree remove "$wt_path"
  done <<< "$selected"

  git worktree prune
}

# "git worktree list"
function gwl() {
  git worktree list
}



# stage-commit-version-files
function scvf() {
	git diff --name-only "$1~1" "$1"|xargs git checkout "$1"
}
# working-directory-commit-version-files
function wdcvf() {
	git diff --name-only "$1~1" "$1"|xargs git checkout "$1"
	git diff --name-only "$1~1" "$1"|xargs git reset
}
function apply-commit-version-diff() {
	git apply <(git diff "$1~1" "$1")
}
# `tre` is a shorthand for `tree` with hidden files and color enabled, ignoring
# the `.git` directory, listing directories first. The output gets piped into
# `less` with options to preserve color and line numbers, unless the output is
# small enough for one screen.
function tre() {
	tree -aC -I '.git|node_modules|bower_components' --dirsfirst "$@" | less -FRNX;
}
# `o` with no arguments opens the current directory, otherwise opens the given
# location
function o() {
	if [ $# -eq 0 ]; then
		open .;
	else
		open "$@";
	fi;
}
# fix history file corruption
function fixHistfileCorruption() {
  mv "$HOME/.histfile" "$HOME/.histfile_bad"
  strings -eS "$HOME/.histfile_bad" > "$HOME/.histfile"
  fc -R "$HOME/.histfile"
  rm "$HOME/.histfile_bad"
}
# Puts a random UUID on the clipboard.
uuid() {
  UUID=$(uuidgen | tr -d '\n'|tr '[:upper:]' '[:lower:]')
  echo "$UUID" | tr -d '\n'|pbcopy
  echo "$UUID"
}

# Run `dig` and display the most useful info.
# Or use `drill` instead.
function digga() {
	dig +nocmd "$1" any +multiline +noall +answer;
}
# Determine size of a file or total size of a directory
function fs() {
	if du -b /dev/null > /dev/null 2>&1; then
		local arg=-sbh;
	else
		local arg=-sh;
	fi
	if [[ -n "$@" ]]; then
		du $arg -- "$@";
	else
		du $arg .[^.]* ./*;
	fi;
}
# Create a new directory and enter it
function mkd() {
	mkdir -p "$@" && cd "$_";
}

decode-jwt() {
  local token
  token=$(cat | tr -d '[:space:]')

  if [ -z "$token" ]; then
    echo "Error: no input" >&2
    return 1
  fi

  # Validate rough JWT shape (three dot-separated parts)
  if [[ $(echo "$token" | tr -cd '.' | wc -c) -ne 2 ]]; then
    echo "Error: input does not look like a JWT (expected header.payload.signature)" >&2
    return 1
  fi

  _decode_part() {
    local part="$1"
    # Restore standard base64 alphabet from base64url
    part=$(echo "$part" | tr -- '-_' '+/')
    # Add padding
    local pad=$(( (4 - ${#part} % 4) % 4 ))
    printf '%s%s' "$part" "$(printf '=%.0s' $(seq 1 $pad))" | base64 --decode 2>/dev/null
  }

  local header payload
  header=$(echo "$token" | cut -d. -f1)
  payload=$(echo "$token" | cut -d. -f2)

  echo "=== Header ==="
  _decode_part "$header" | python3 -m json.tool

  echo "=== Payload ==="
  _decode_part "$payload" | python3 -m json.tool
}

# To use java jar as cli tool.
# Place executable jars into $HOME/.tools/cli/java/jars,
# like bnd, and use like 'jjar bnd version'.
function jjar() {
  java -jar "$HOME/.tools/cli/java/jars/$1" "${@:2}"  
}
# Show wifi password for given SSID name.
function passwordForSsid() {
  nmcli --show-secrets connection show "$1"|grep wireless-security.psk:
}
# Show manually installed packages for xbuntu/debian.
function listManuallyInstalledPackagesApt() {
  comm -23 <(apt-mark showmanual | sort -u) <(gzip -dc /var/log/installer/initial-status.gz | sed -n 's/^Package: //p' | sort -u)
}
# Show manually installed packages for brew.
function listManuallyInstalledPackagesBrew() {
  brew list|sed 's/  /\\n/g'
}
# Show manually installed snap packages.
function listManuallyInstalledPackagesSnap() {
  snap list|grep -oIP '^[\w-]+'|tail -n +2
}

function ppgrep() { pgrep "$@" | xargs --no-run-if-empty ps fp; }

# k8s - allows you to tail logs of services even between restarts
klogs() {
  local service=$1
  kubectl logs services/$service -f ; echo "Disconected, awaiting service to come back online" && sleep 1 && log $service
}

# Copies the commit message of the commit of the 1st (or xth)
# commit ahead of HEAD to the clipboard.
copyCommitAheadMessage() {
  num_commits_ahead=${1:-1}
  eval "git rev-list --format=%B --max-count=1 HEAD@{$num_commits_ahead}|tail -n +2|pbcopy"
  echo "copied commit message to clipboard:\n$(pbpaste)"
}

function whoseUsingPort() {
  lsof -i -P | grep LISTEN | grep :$1 
}

function kshark() {
  kubectl exec $1 -- yum install -y tcpdump && kubectl exec $1 -- tcpdump -i eth0 -w - | wireshark -k -i - 
}

function grep-get-pod-name() {
  kubectl get pods --no-headers -o custom-columns=":metadata.name"|grep $1|head -n 1
}

function is-pod-name-up() {
	[[ $(kubectl get pod $(grep-get-pod-name $1) -n default -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}') == "True" ]]
}

function wait-until-pod-name-up() {
	echo "Waiting until pod $1 is up..."
	until is-pod-name-up "$1"; do
		sleep 1
	done
	echo "Pod $1 is up!"
}

function fzf-get-pod-name() {
  kubectl get pods --no-headers -o custom-columns=":metadata.name"|fzf
}

function clean-k-logs() {
  sed -e 's#\\n#\n#g' -e 's#\\t#\t#g'
}

function k-nuke-all() {
	kubectl delete deployments --all && kubectl delete services --all && kubectl delete configmap --all && kubectl delete jobs.batch --all;
}

function k-logs-by-name() {
  kubectl logs $(grep-get-pod-name $1)|clean-k-logs
}

function watch-k-logs-by-name() {
  watch --color -p -n 1 --exec zsh -c "source ~/.function && k-logs-by-name $1"
}

# Pretty printing
# $1 file to operate on
# $2 file to save as
function pretty-xml-inplace() {
	xmllint --format --output "$2" "$1"
}

function pretty-all-xml-inplace() {
	find . -type f -name "*.xml" -print0 | xargs -0 -I{} sh -c 'xmllint --format "{}" > "{}.tmp" && mv "{}.tmp" "{}"'
}

function url-decode() {
  # Supports both input from arguments and from stdin.
	if [ $# -gt 0 ]; then
		echo "$*"
	else
		cat
	fi | python3 -c "import sys, urllib.parse; print(urllib.parse.unquote(sys.stdin.read().strip()))"
}

# lazy load nvm, sdkman and bun
nvm-init() {
  echo "Initializing nvm..."
  unset npm_config_prefix
  unset -f nvm node npm npx
  export NVM_INIT=1
  export NVM_DIR="$HOME/.nvm"
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
  [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
}
nvm() {
  if [[ -n $NVM_INIT ]]; then
    nvm "$@"
  else
    nvm-init
    nvm "$@"
  fi
}
node() {
  if [[ -n $NVM_INIT ]]; then
    node "$@"
  else
    nvm-init
    node "$@"
  fi
}
npm() {
  if [[ -n $NVM_INIT ]]; then
    npm "$@"
  else
    nvm-init
    npm "$@"
  fi
}
npx() {
  if [[ -n $NVM_INIT ]]; then
    npx "$@"
  else
    nvm-init
    npx "$@"
  fi
}

# sdkman takes a long time to load, so make it lazy.
# Unless you use it daily!
# sdk() {
#   if [[ -n $SDKMAN_INIT ]]; then
#     sdk "$@"
#   else
#     export SDKMAN_INIT=1
#     echo "Initializing SDKMAN..."
#     source "$HOME/.sdkman/bin/sdkman-init.sh"
#     sdk "$@"
#   fi
# }

bun() {
  if [[ -n $BUN_INIT ]]; then
    $HOME/.bun/bin/bun "$@"
  else
    echo "Initializing bun..."
    export BUN_INIT=1
    # Load auto completions if not bash shell
    if [ -z "$BASH_VERSION" ]; then
      echo "Adding completions..."
      [ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun" # bun completions
    fi
    export BUN_INSTALL="$HOME/.bun"
    export PATH="$BUN_INSTALL/bin:$PATH"
    $HOME/.bun/bin/bun "$@"
  fi
}
